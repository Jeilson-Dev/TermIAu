{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermIAu",
  "version": "0.1.0",
  "identifier": "dev.jeilson.termiau",
  "build": {
    "beforeDevCommand": "npm run marketplace && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run marketplace && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermIAu",
        "width": 1000,
        "height": 640,
        "backgroundColor": "#282a36",
        "theme": "Dark",
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist-marketplace/": "marketplace/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/plugin.icns": "icons/plugin.icns"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
