{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermIAu",
  "version": "0.1.0",
  "identifier": "dev.jeilson.termiau",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermIAu",
        "width": 1000,
        "height": 640,
        "backgroundColor": "#14161a",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
