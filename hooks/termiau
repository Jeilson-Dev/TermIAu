#!/usr/bin/env bash
# Shows a file in the viewer of the TermIAu panel it was called from.
#
#   termiau view src/main.ts:848          the file, scrolled to the line with it marked
#   termiau view src/main.ts:848-870      the whole range marked
#   termiau view docs/plan.md             .md opens rendered
#   termiau view lib/x.dart:103 --ref main   the file as it is on main
#
# The app writes this script to ~/.termiau/bin every time it opens (see
# `install_cli` in lib.rs). Like the hook, it only talks to the app's socket:
# TERMIAU_PANEL says which panel the request is from; the panel's shell
# inherits it — and so does Claude, running in it.
set -uo pipefail

usage() {
  echo "usage: termiau view <file>[:line[-line]] [--ref <branch|commit>]" >&2
  echo "       termiau progress < plan.json      the task's progress, in the footer" >&2
  echo "       termiau progress --clear          takes it off" >&2
  exit 2
}

PANEL="${TERMIAU_PANEL:-0}"
case "$PANEL" in '' | *[!0-9]*) PANEL=0 ;; esac

# ---------- termiau progress: a long task's plan, in the footer ----------
#
# The whole plan, as JSON on stdin; each call replaces the previous one. It goes as
# text (escaped here, without `jq`) and the app parses and checks it: what is wrong
# comes back on this connection and becomes this command's error — that is how Claude
# learns to fix it. See progress.rs.
if [ "${1:-}" = progress ]; then
  shift
  if [ -z "${TERMIAU_SOCK:-}" ] || [ ! -S "$TERMIAU_SOCK" ]; then
    echo "termiau: only works inside a TermIAu panel" >&2
    exit 1
  fi
  case "${1:-}" in
    --clear) plan=null ;;
    "") plan=$(cat) ;;
    *) usage ;;
  esac
  if [ -z "${plan//[[:space:]]/}" ]; then
    echo "termiau: the plan (JSON) goes on stdin" >&2
    exit 2
  fi
  plan=${plan//\\/\\\\}
  plan=${plan//\"/\\\"}
  plan=${plan//$'\n'/\\n}
  plan=${plan//$'\r'/\\r}
  plan=${plan//$'\t'/\\t}
  answer=$(printf '{"panel":%s,"progress_text":"%s"}\n' "$PANEL" "$plan" | nc -U "$TERMIAU_SOCK" -w 2 2>/dev/null)
  case "$answer" in
    ok) echo "progress updated in the TermIAu footer" ;;
    error:*) echo "termiau: plan rejected — $answer" >&2; exit 1 ;;
    *) echo "termiau: the app did not respond" >&2; exit 1 ;;
  esac
  exit 0
fi

[ "${1:-}" = view ] || usage
shift

target="" ref=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) ref="${2:-}"; [ -n "$ref" ] || usage; shift 2 ;;
    --ref=*) ref="${1#--ref=}"; shift ;;
    -*) usage ;;
    *) [ -z "$target" ] || usage; target="$1"; shift ;;
  esac
done
[ -n "$target" ] || usage

if [ -z "${TERMIAU_SOCK:-}" ] || [ ! -S "$TERMIAU_SOCK" ]; then
  echo "termiau: only works inside a TermIAu panel" >&2
  exit 1
fi

# `file:10`, `file:10-20`, `file:10:5` (the column is ignored) and GitHub
# links' `#L10-L20`.
line="" to=""
# One format at a time: `(.+)` is greedy, and on a `:10:5` it alone would swallow the `:10`.
if [[ "$target" =~ ^(.+)#L([0-9]+)(-L([0-9]+))?$ ]] ||
  [[ "$target" =~ ^(.+):([0-9]+):[0-9]+$ ]] ||
  [[ "$target" =~ ^(.+):([0-9]+)(-([0-9]+))?$ ]]; then
  target="${BASH_REMATCH[1]}"
  line="${BASH_REMATCH[2]}"
  to="${BASH_REMATCH[4]:-}"
fi

case "$target" in
  /*) ;;
  "~/"*) target="$HOME/${target#"~/"}" ;;
  *) target="$PWD/$target" ;;
esac

if [ -z "$ref" ] && [ ! -f "$target" ]; then
  echo "termiau: no such file: $target" >&2
  exit 1
fi
if [ -n "$ref" ] && [ ! -d "$(dirname "$target")" ]; then
  echo "termiau: no such folder: $(dirname "$target")" >&2
  exit 1
fi

# JSON without `jq`: only quotes and backslashes need escaping in a path.
json() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
num() { [ -n "$1" ] && printf '%s' "$1" || printf null; }
txt() { [ -n "$1" ] && json "$1" || printf null; }

printf '{"panel":%s,"view":{"path":%s,"line":%s,"to":%s,"ref":%s}}\n' \
  "$PANEL" "$(json "$target")" "$(num "$line")" "$(num "$to")" "$(txt "$ref")" |
  nc -U "$TERMIAU_SOCK" -w 1 >/dev/null 2>&1 || {
  echo "termiau: the app did not respond" >&2
  exit 1
}

echo "opened in the TermIAu viewer: $target${line:+:$line}${to:+-$to}${ref:+ (at $ref)}"
