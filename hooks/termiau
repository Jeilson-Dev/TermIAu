#!/usr/bin/env bash
# Shows a file in the viewer of the TermIAu panel it was called from.
#
#   termiau ver src/main.ts:848          the file, scrolled to the line with it marked
#   termiau ver src/main.ts:848-870      the whole range marked
#   termiau ver docs/plan.md             .md opens rendered
#   termiau ver lib/x.dart:103 --ref main   the file as it is on main
#
# The app writes this script to ~/.termiau/bin every time it opens (see
# `instalar_cli` in lib.rs). Like the hook, it only talks to the app's socket:
# TERMIAU_PAINEL says which panel the request is from; the panel's shell
# inherits it — and so does Claude, running in it.
set -uo pipefail

uso() {
  echo "usage: termiau ver <file>[:line[-line]] [--ref <branch|commit>]" >&2
  exit 2
}

[ "${1:-}" = ver ] || uso
shift

alvo="" ref=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) ref="${2:-}"; [ -n "$ref" ] || uso; shift 2 ;;
    --ref=*) ref="${1#--ref=}"; shift ;;
    -*) uso ;;
    *) [ -z "$alvo" ] || uso; alvo="$1"; shift ;;
  esac
done
[ -n "$alvo" ] || uso

if [ -z "${TERMIAU_SOCK:-}" ] || [ ! -S "$TERMIAU_SOCK" ]; then
  echo "termiau: only works inside a TermIAu panel" >&2
  exit 1
fi

# `file:10`, `file:10-20`, `file:10:5` (the column is ignored) and GitHub
# links' `#L10-L20`.
linha="" ate=""
# One format at a time: `(.+)` is greedy, and on a `:10:5` it alone would swallow the `:10`.
if [[ "$alvo" =~ ^(.+)#L([0-9]+)(-L([0-9]+))?$ ]] ||
  [[ "$alvo" =~ ^(.+):([0-9]+):[0-9]+$ ]] ||
  [[ "$alvo" =~ ^(.+):([0-9]+)(-([0-9]+))?$ ]]; then
  alvo="${BASH_REMATCH[1]}"
  linha="${BASH_REMATCH[2]}"
  ate="${BASH_REMATCH[4]:-}"
fi

case "$alvo" in
  /*) ;;
  "~/"*) alvo="$HOME/${alvo#"~/"}" ;;
  *) alvo="$PWD/$alvo" ;;
esac

if [ -z "$ref" ] && [ ! -f "$alvo" ]; then
  echo "termiau: no such file: $alvo" >&2
  exit 1
fi
if [ -n "$ref" ] && [ ! -d "$(dirname "$alvo")" ]; then
  echo "termiau: no such folder: $(dirname "$alvo")" >&2
  exit 1
fi

PAINEL="${TERMIAU_PAINEL:-0}"
case "$PAINEL" in '' | *[!0-9]*) PAINEL=0 ;; esac

# JSON without `jq`: only quotes and backslashes need escaping in a path.
json() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
num() { [ -n "$1" ] && printf '%s' "$1" || printf null; }
txt() { [ -n "$1" ] && json "$1" || printf null; }

printf '{"painel":%s,"ver":{"caminho":%s,"linha":%s,"ate":%s,"ref":%s}}\n' \
  "$PAINEL" "$(json "$alvo")" "$(num "$linha")" "$(num "$ate")" "$(txt "$ref")" |
  nc -U "$TERMIAU_SOCK" -w 1 >/dev/null 2>&1 || {
  echo "termiau: the app did not respond" >&2
  exit 1
}

echo "opened in the TermIAu viewer: $alvo${linha:+:$linha}${ate:+-$ate}${ref:+ (at $ref)}"
